#ifndef FS_SECRETS_H
#define FS_SECRETS_H

/* 
 * Field Shift - Configuration Secrets & Site Coordinates
 * Copy this file to fs_secrets.h and fill in your credentials.
 * fs_secrets.h is git-ignored to prevent leaking credentials.
 */

#define FS_WIFI_SSID      "YOUR_WIFI_SSID"
#define FS_WIFI_PSWD      "YOUR_WIFI_PASSWORD"

/* Geographic coordinates of the farm plot (in decimal degrees) */
#define FS_SITE_LAT       "37.5508"         /* Field latitude  */
#define FS_SITE_LON       "127.0739"        /* Field longitude */

/* Initial fallback date (YYYYMMDD) until NASA HTTP Date header syncs the clock */
#define FS_START_DATE_YMD "20261115"

#endif /* FS_SECRETS_H */
